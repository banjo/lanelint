{
  "name": "archlint",
  "version": "0.0.0",
  "description": "Fast, structure-agnostic architecture checks for TypeScript projects, built for AI agents.",
  "license": "MIT",
  "bin": {
    "archlint": "./src/cli/index.ts"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "archlint": "./dist/cli.mjs"
    },
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@archlint/core": "workspace:*",
    "c12": "catalog:",
    "citty": "catalog:",
    "jiti": "catalog:"
  },
  "devDependencies": {
    "@archlint/plugin-boundaries": "workspace:*",
    "@archlint/plugin-changes": "workspace:*",
    "@archlint/plugin-conventions": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
