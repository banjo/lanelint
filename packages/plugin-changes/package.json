{
  "name": "@lanelint/plugin-changes",
  "version": "0.0.1",
  "description": "lanelint rules for files that must or must not change together.",
  "homepage": "https://github.com/banjo/lanelint/tree/main/packages/plugin-changes#readme",
  "bugs": {
    "url": "https://github.com/banjo/lanelint/issues"
  },
  "license": "MIT",
  "author": "Anton Ödman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banjo/lanelint.git",
    "directory": "packages/plugin-changes"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@valibot/to-json-schema": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@lanelint/core": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@lanelint/core": "workspace:^"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
