{
  "name": "lanelint",
  "version": "0.0.1",
  "description": "An architecture linter for TypeScript, built for coding agents.",
  "keywords": [
    "agents",
    "ai",
    "architecture",
    "boundaries",
    "coding-agents",
    "lint",
    "linter",
    "typescript"
  ],
  "homepage": "https://github.com/banjo/lanelint#readme",
  "bugs": {
    "url": "https://github.com/banjo/lanelint/issues"
  },
  "license": "MIT",
  "author": "Anton Ödman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banjo/lanelint.git",
    "directory": "packages/lanelint"
  },
  "bin": {
    "lanelint": "./src/cli/index.ts"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "lanelint": "./dist/cli.mjs"
    },
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "bench": "node tests/bench.ts",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@lanelint/core": "workspace:*",
    "citty": "catalog:",
    "jiti": "catalog:"
  },
  "devDependencies": {
    "@lanelint/plugin-boundaries": "workspace:*",
    "@lanelint/plugin-changes": "workspace:*",
    "@lanelint/plugin-conventions": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
