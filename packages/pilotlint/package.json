{
  "name": "pilotlint",
  "version": "0.0.0",
  "description": "Keeps coding agents on course. A fast architecture linter for TypeScript projects.",
  "keywords": [
    "agents",
    "ai",
    "architecture",
    "boundaries",
    "coding-agents",
    "lint",
    "linter",
    "typescript"
  ],
  "license": "MIT",
  "bin": {
    "pilotlint": "./src/cli/index.ts"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "pilotlint": "./dist/cli.mjs"
    },
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@pilotlint/core": "workspace:*",
    "c12": "catalog:",
    "citty": "catalog:",
    "jiti": "catalog:"
  },
  "devDependencies": {
    "@pilotlint/plugin-boundaries": "workspace:*",
    "@pilotlint/plugin-changes": "workspace:*",
    "@pilotlint/plugin-conventions": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
