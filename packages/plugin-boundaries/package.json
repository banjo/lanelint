{
  "name": "@archlint/plugin-boundaries",
  "version": "0.0.0",
  "description": "archlint rules for dependencies between elements and on packages.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@archlint/core": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@archlint/core": "workspace:^"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
