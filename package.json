{
  "name": "pilotlint-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run pilotlint",
    "bench": "vp run --no-cache pilotlint#bench",
    "pilotlint": "pilotlint check",
    "docs:rules": "pilotlint rules docs",
    "changeset": "changeset",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@pilotlint/plugin-boundaries": "workspace:*",
    "@pilotlint/plugin-changes": "workspace:*",
    "@pilotlint/plugin-conventions": "workspace:*",
    "@types/node": "catalog:",
    "pilotlint": "workspace:*",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
